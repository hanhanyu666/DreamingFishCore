          "subjectId": "dreamingfishcore:opening/zhoucen/contact_channel",
          "secondaryId": "ask_about_zhuiguang",
          "locationId": "",
          "scope": "PLAYER",
          "conditions": {"cursor": "ask_zhoucen", "membership": "NON_MEMBER"},
          "effects": [
            {"id": "resolve_contact_guidance", "type": "RESOLVE_GUIDANCE", "parameters": {
