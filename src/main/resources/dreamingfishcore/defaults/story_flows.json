            }},
            {"id": "membership_guidance", "type": "CREATE_GUIDANCE", "parameters": {
              "id": "dreamingfishcore:guidance/opening/choose_membership",
              "title": "决定是否加入逐光会",
              "content": "阅读周岑发来的介绍，然后使用消息下方的预设选项作出决定。",
              "stageId": "dreamingfishcore:dream_beginning",
              "sourceEventId": "dreamingfishcore:opening/event/zhuiguang_introduction",
              "sourceNpcId": "105",
              "sourceName": "周岑",
              "sourceQuote": "加入与否由你自己决定"
            }},
            {"id": "sync_player", "type": "SYNC_PLAYER"}
          ],
          "dialogueNpcId": 101,
          "dialogueLines": [
            "逐光会还只是个开头：仓库、救援交接点和能让人过夜的地方，都要一点点搭起来。愿意加入就一起建设，不加入也能在阿拜多斯生活、看病和做交易。",
            "周岑负责登记和具体安排。我把他的联络方式发到你的终端了，先听他把条件讲完，再按自己的想法决定。"
          ],
          "nextNodeId": "membership_choice"
        },
        {
          "id": "membership_choice",
          "event": "PLAYER_AUTHENTICATED",
          "subjectId": "",
          "secondaryId": "",
          "locationId": "",
          "scope": "PLAYER",
          "conditions": {"cursor": "membership_choice", "membership": "NON_MEMBER"},
          "effects": [],
          "repeatable": true,
          "dialogueNpcId": 101,
          "dialogueLines": ["周岑会把成员要承担的事情、能得到的补给和基地安排讲清楚。你听完再选，不用急着回答。"]
        },
        {
          "id": "join_zhuiguang",
