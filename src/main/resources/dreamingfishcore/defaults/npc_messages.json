    {
      "id": "dreamingfishcore:opening/liaison/network_online",
      "npcId": 100,
      "subject": "应急联络恢复",
      "content": "这里是梦屿应急联络组。先说明情况：丧尸危机发生不到几天，医疗、能源、警备、物流、重生管理和居民自治正在接入同一条线路。“逐光会”现在只有一个刚提出的名字、几条不稳定的通信线和不够用的人手。你如果愿意参与，请先让自己和身边的人有一处能过夜的地方。等你安顿好，我们想和幸存者一起建一座联络站。",
      "trigger": "MANUAL",
      "once": true,
      "priority": 0,
      "minimumFavorability": -1000,
      "maximumFavorability": 1000,
      "membershipRequirement": "ANY",
      "replies": [
        {
          "id": "request_plan",
          "text": "把联络站需要什么发给我。",
          "minimumFavorability": -1000,
          "maximumFavorability": 1000,
          "favorabilityDelta": 2,
          "followUpMessageId": "dreamingfishcore:opening/liaison/station_request",
          "membershipRequirement": "ANY",
          "membershipAction": "NONE"
        },
        {
          "id": "settle_first",
          "text": "我会先找安全处，安顿好再联系。",
          "minimumFavorability": -1000,
          "maximumFavorability": 1000,
          "favorabilityDelta": 1,
          "followUpMessageId": "dreamingfishcore:opening/liaison/settle_first",
          "membershipRequirement": "ANY",
          "membershipAction": "NONE"
        },
        {
          "id": "stay_independent",
          "text": "我暂时只想照顾自己的生活。",
          "minimumFavorability": -1000,
          "maximumFavorability": 1000,
          "favorabilityDelta": 0,
          "followUpMessageId": "dreamingfishcore:opening/liaison/no_pressure",
          "membershipRequirement": "ANY",
          "membershipAction": "NONE"
        }
