      "npcId": 1,
      "subject": "只对熟人说的话",
      "content": "既然我们已经熟悉，我可以多说一点：最早的安排每天都在变化。不要把任何人的短期判断当作最终答案，先保留记录，再和其他幸存者交叉验证。",
      "trigger": "INTERACTION",
      "once": true,
      "priority": 20,
      "minimumFavorability": 100,
      "maximumFavorability": 1000,
      "membershipRequirement": "ANY",
      "replies": [
        {
          "id": "understood",
          "text": "明白，我会先验证再下结论。",
          "minimumFavorability": 100,
          "maximumFavorability": 1000,
          "favorabilityDelta": 2,
          "followUpMessageId": "",
          "membershipRequirement": "ANY",
          "membershipAction": "NONE"
