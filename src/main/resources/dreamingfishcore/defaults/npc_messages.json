      "npcId": 100,
      "subject": "联络站的第一张清单",
      "content": "先选一个你们愿意长期使用的地点。我们需要稳定照明、几张床、能分类存放物资的空间、基础医疗区，以及一条不会被随手拆掉的供电线路。不要求照图建造，也不要求把建筑交给逐光会；这会是你们的地方，只在需要时承担公共联络和接应。",
      "trigger": "FOLLOW_UP",
      "once": true,
      "priority": 0,
      "minimumFavorability": -1000,
      "maximumFavorability": 1000,
      "membershipRequirement": "ANY",
      "replies": [
        {
          "id": "choose_site",
          "text": "地点由我们来定，建好后给你回信。",
          "minimumFavorability": -1000,
          "maximumFavorability": 1000,
          "favorabilityDelta": 2,
          "followUpMessageId": "",
          "membershipRequirement": "ANY",
          "membershipAction": "NONE"
