  "102": {
    "npcId": 102,
    "npcName": "江晚",
    "npcIntroduction": "谨慎的微生物研究者。她会明确区分已知事实、合理推测、尚无证据与无法排除的风险。",
    "npcGender": "女",
    "npcFeamale": null,
    "npcProfession": "微生物研究员",
    "storyStageId": 1,
    "dialogues": [
