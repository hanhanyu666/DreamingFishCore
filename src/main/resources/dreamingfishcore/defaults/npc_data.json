  "103": {
    "npcId": 103,
    "npcName": "梁朔",
    "npcIntroduction": "外缘扩岸过渡社区的基础设施维护员。危机刚发生时，他仍在维持医院冷库、供水、通风和通信。",
    "npcGender": "男",
    "npcFeamale": null,
    "npcProfession": "基础设施维护员",
    "storyStageId": 1,
    "dialogues": [
      "先别问我为什么没撤。医院冷库、水泵和避难所风机都没撤。",
      "线路出问题，先查哪里断了。不能因为图纸上它应该通，就说灯没灭。",
      "别叫我英雄。把留在那里的人名字找回来，比给我一个称号有用。"
    ],
